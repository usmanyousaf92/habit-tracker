<?xml version="1.0" encoding="utf-8"?>
<!-- The hero gradient from the Home banner: #16301F -> #2F6B3E, 155deg. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- angle MUST be a multiple of 45; GradientDrawable throws otherwise.
         315 = top-left to bottom-right, the closest legal match to the
         stylesheet's 155deg hero gradient. -->
    <gradient
        android:angle="315"
        android:endColor="@color/icon_bg_end"
        android:startColor="@color/icon_bg_start"
        android:type="linear" />
</shape>
